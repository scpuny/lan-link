{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanLink",
  "version": "0.1.0",
  "identifier": "com.lanlink.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev --prefix ../web",
    "beforeBuildCommand": "npm run build --prefix ../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LanLink",
        "width": 1180,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 760,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
